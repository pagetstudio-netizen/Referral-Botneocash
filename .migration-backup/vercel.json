{
  "version": 2,
  "buildCommand": "cd artifacts/admin-dashboard && npm install && BASE_PATH=/ npx vite build --config vite.config.ts",
  "outputDirectory": "artifacts/admin-dashboard/dist/public",
  "installCommand": "cd artifacts/api-server && npm install --omit=dev",
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot|map))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
